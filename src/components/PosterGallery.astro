---
// Conference photos (posters, talk slides, events) with a zoomable lightbox (src/scripts/lightbox.js).
//   layout "stack": full content width, natural aspect (a paper page with a few photos)
//   layout "grid":  uniform 4:3 cards with a caption (the Photos page)
// caption: { title, meta, href? } — href links the card and lightbox caption to the paper or workshop.
// width/height come from the zoom image, so the browser reserves space before images load.
import { url } from "../lib/url.js";

interface Photo { src: string; thumb: string; zoom: string; width: number; height: number }
interface Caption { title: string; meta: string; href?: string }
interface Props {
  items: { photo: Photo; caption: Caption }[];
  layout?: "stack" | "grid";
}
const { items, layout = "grid" } = Astro.props;
const sizes = layout === "stack" ? "(max-width: 860px) 100vw, 812px" : "(max-width: 600px) 100vw, 300px";
---
<div class={`poster-gallery ${layout}`} data-gallery>
  {items.map(({ photo, caption }, i) => (
    <figure class="poster-card">
      <a
        href={url(photo.zoom)}
        data-pswp-width={photo.width}
        data-pswp-height={photo.height}
        target="_blank"
        rel="noopener"
        aria-label={`Open photo ${i + 1} of ${items.length} in zoomable viewer: ${caption.title}`}
      >
        <img
          src={url(layout === "stack" ? photo.src : photo.thumb)}
          srcset={`${url(photo.thumb)} 480w, ${url(photo.src)} 1600w`}
          sizes={sizes}
          width={photo.width}
          height={photo.height}
          alt={`Photo: ${caption.title}`}
          loading={i === 0 && layout === "stack" ? "eager" : "lazy"}
          decoding="async"
        />
        <span class="zoom-hint" aria-hidden="true">⤢ Zoom</span>
      </a>
      {layout === "grid" && (
        <figcaption>
          {caption.href ? <a href={caption.href}>{caption.title}</a> : <b>{caption.title}</b>}
          <span class="muted">{caption.meta}</span>
        </figcaption>
      )}
      <template class="pswp-caption">
        <div class="pswp-cap">
          <b>{caption.title}</b>
          <span>{caption.meta}</span>
          {layout === "grid" && caption.href && <a href={caption.href}>Details →</a>}
        </div>
      </template>
    </figure>
  ))}
</div>
<script>
  import "../scripts/lightbox.js";
</script>
