---
import Base from "../layouts/Base.astro";
import { noteIndex } from "../lib/notes.js";
const notes = await noteIndex();
---
<Base title="IROS 2026 Papers" active="papers">
  <main class="layout">
    <aside class="filters" aria-label="Filters">
      <label class="field">
        <span>Search</span>
        <input id="q" type="search" placeholder="title, author, affiliation, keyword…" autocomplete="off" />
      </label>
      <fieldset class="field">
        <legend>Day</legend>
        <div id="days" class="chips"></div>
      </fieldset>
      <label class="field">
        <span>Session type</span>
        <select id="type"><option value="">All types</option></select>
      </label>
      <label class="field">
        <span>Session</span>
        <select id="session"><option value="">All sessions</option></select>
      </label>
      <label class="field">
        <span>Keyword</span>
        <select id="kw"><option value="">All keywords</option></select>
      </label>
      <label class="field">
        <span>Topic</span>
        <select id="topic"><option value="">All topics</option></select>
      </label>
      <div class="field toggles">
        <label><input id="rel" type="checkbox" /> Calibration &amp; state estimation only</label>
        <label><input id="noted" type="checkbox" /> With my photos <span id="noted-count" class="muted"></span></label>
        <label><input id="star" type="checkbox" /> Bookmarked only <span id="star-count" class="muted"></span></label>
      </div>
      <label class="field">
        <span>Sort</span>
        <select id="sort">
          <option value="time">Day &amp; time</option>
          <option value="title">Title</option>
        </select>
      </label>
      <button id="reset" type="button" class="link-btn">Clear all filters</button>
    </aside>
    <section class="results" aria-live="polite">
      <p id="summary" class="summary">Loading papers…</p>
      <div id="list"></div>
      <button id="more" type="button" class="more" hidden></button>
    </section>
  </main>
  <script type="application/json" id="notes-index" set:html={JSON.stringify(notes)} />
  <script>
    import "../scripts/papers-page.js";
  </script>
</Base>
