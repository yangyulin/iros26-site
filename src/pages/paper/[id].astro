---
import Base from "../../layouts/Base.astro";
import PosterGallery from "../../components/PosterGallery.astro";
import { render } from "astro:content";
import papers from "../../../data/papers.json";
import { loadNotes } from "../../lib/notes.js";
import { pdfs } from "../../lib/pdfs.js";
import { infovaya, infovayaUrl } from "../../lib/infovaya.js";
import { url } from "../../lib/url.js";

export async function getStaticPaths() {
  const notes = await loadNotes();
  const bySession = new Map();
  for (const p of papers) {
    if (!bySession.has(p.session_id)) bySession.set(p.session_id, []);
    bySession.get(p.session_id).push(p);
  }
  return papers.map((p) => {
    const siblings = bySession.get(p.session_id);
    const i = siblings.indexOf(p);
    return {
      params: { id: p.id },
      props: { p, prev: siblings[i - 1] ?? null, next: siblings[i + 1] ?? null, note: notes.get(p.id) ?? null },
    };
  });
}

const { p, prev, next, note } = Astro.props;
const Content = note ? (await render(note)).Content : null;
const hasText = Boolean(note?.body?.trim());
const affs = [...new Set(p.affiliations.filter(Boolean))];
const listUrl = (params) => url(`index.html#${new URLSearchParams(params)}`);
const DATE = { Monday: "Mon 28 Sep", Tuesday: "Tue 29 Sep", Wednesday: "Wed 30 Sep" };
const pdf = pdfs[p.id] ?? null;
const ivId = infovaya[p.id] ?? null;
const TOPIC_LABEL = {
  slam: "SLAM", inertial: "Inertial", semantic: "Semantic", localization: "Localization",
  mapping: "Mapping", "feed-forward": "Feed-forward / transformer", calibration: "Calibration",
};
---
<Base title={`${p.title} — IROS 2026`} description={`IROS 2026 paper #${p.id}: ${p.title}`}>
  <main class="paper-page">
    <p class="crumbs"><a href={url("index.html")}>← All papers</a></p>
    <article>
      <h1>{p.title}</h1>
      <p class="badges">
        {p.relevant && <span class="badge">calib &amp; state est.</span>}
        {p.session_type === "Award Candidates" && <span class="badge award">award candidate</span>}
        <button type="button" class="star-btn inline" data-star={p.id} aria-pressed="false">☆ Bookmark</button>
        {pdf && (
          <a class="pdf-btn" href={pdf.url} target="_blank" rel="noopener">
            PDF{pdf.source === "arxiv" ? " (arXiv)" : ""} ↗
          </a>
        )}
        {ivId && (
          <a class="iv-btn" href={infovayaUrl(ivId)} target="_blank" rel="noopener" title="IROS attendee login required">
            Infovaya ↗
          </a>
        )}
      </p>
      <p class="authors">{p.authors.join(", ")}</p>
      {affs.length > 0 && <p class="affs">{affs.join(" · ")}</p>}
      <dl class="facts">
        <dt>When</dt><dd>{DATE[p.day]}, {p.time}</dd>
        <dt>Room</dt><dd>{p.room}</dd>
        <dt>Session</dt><dd><a href={listUrl({ session: p.session_id })}>{p.session}</a> · {p.session_type}</dd>
        <dt>Code</dt><dd>{p.code}</dd>
        {p.topics.length > 0 && (
          <>
            <dt>Topics</dt>
            <dd class="kw">{p.topics.map((t) => <a class="topic" href={listUrl({ topic: t })}>{TOPIC_LABEL[t]}</a>)}</dd>
          </>
        )}
        <dt>Keywords</dt><dd class="kw">{p.keywords.map((k) => <a href={listUrl({ kw: k })}>{k}</a>)}</dd>
      </dl>
      {note && (
        <section class="notes">
          <h2>Poster notes</h2>
          {hasText && Content && <div class="note-text"><Content /></div>}
          {note.data.photos.length > 0 && (
            <PosterGallery layout="stack" items={note.data.photos.map((photo) => ({ photo, paper: p }))} />
          )}
        </section>
      )}
      <nav class="session-nav" aria-label="Same session">
        {prev ? <a href={url(`paper/${prev.id}.html`)}>← {prev.time} {prev.title}</a> : <span />}
        {next ? <a href={url(`paper/${next.id}.html`)}>{next.time} {next.title} →</a> : <span />}
      </nav>
      <div id="comments-slot"></div>
    </article>
  </main>
  <script>
    import { KEYS, loadSet, saveSet } from "../../lib/stars.js";

    const btn = document.querySelector("[data-star]");
    const stars = loadSet(KEYS.papers);
    const paint = () => {
      const on = stars.has(btn.dataset.star);
      btn.setAttribute("aria-pressed", String(on));
      btn.textContent = on ? "★ Bookmarked" : "☆ Bookmark";
    };
    paint();
    btn.addEventListener("click", () => {
      const id = btn.dataset.star;
      stars.has(id) ? stars.delete(id) : stars.add(id);
      saveSet(KEYS.papers, stars);
      paint();
    });
  </script>
</Base>
